{
  "name": "stardetect",
  "version": "0.1.0",
  "description": "StarDetect - artistic YOLO object-detection overlay tool for video production",
  "main": "electron/main.js",
  "author": "Internal Video Production",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "deps:check": "python backend/cli.py deps-check",
    "demo": "python backend/cli.py demo --out assets/demo/demo.mp4",
    "smoke": "python tests/smoke_test.py",
    "e2e": "node tests/e2e.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.internal.stardetect",
    "productName": "StarDetect",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "backend/**/*",
      "presets/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "playwright": "^1.60.0"
  }
}
